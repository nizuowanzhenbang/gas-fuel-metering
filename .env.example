# docker-compose 部署时复制为 .env，并按生产环境覆盖以下三项
JWT_SECRET=please-change-to-a-32-byte-random-secret
INTEGRATION_SECRET=please-change-cross-system-integration-secret
ADMIN_PASSWORD=please-change-admin-password

# UTC or fixed UTC+08:00; minutes from midnight (08:00 = 480)
BUSINESS_TIMEZONE=UTC
BUSINESS_DAY_START_MINUTE=0
