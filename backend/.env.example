# 环境配置示例。复制为 .env 后填入真实值。生产请使用 PostgreSQL。
APP_NAME=gas-fuel-metering
APP_PORT=8010

# JWT
JWT_SECRET=change-me-in-production-32-bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# 数据库（开发用 SQLite，生产换 PostgreSQL）
DATABASE_URL=sqlite:///./gas_fuel.db
# DATABASE_URL=postgresql+psycopg2://gasfuel:gasfuel@localhost:5432/gas_fuel

# 跨系统集成暗号
INTEGRATION_SECRET=replace-with-shared-secret

# 上游系统地址（平台内网）
GAS_TURBINE_BASE=http://gas-turbine-performance:8011
FUEL_PROCUREMENT_BASE=http://fuel-procurement:8005
EQUIPMENT_INSPECTION_BASE=http://equipment-inspection:8006
EMISSION_MONITORING_BASE=http://emission-monitoring:8008
PLANT_SAFETY_BASE=http://plant-safety:8004
